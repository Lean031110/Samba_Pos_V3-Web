# =====================================================================
# .gitignore — SambaPOS V3 Web Clone
# =====================================================================

# === Node.js ===
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.pnpm-debug.log*

# === Database files (NEVER commit) ===
data/samba.db
data/samba.db-wal
data/samba.db-shm
data/*.db
data/*.db-*
*.sdf
*.db
*.db-journal

# === Environment / secrets (NEVER commit) ===
.env
.env.*
.env.local
config/secrets.js
config/local.js
**/.env
**/credentials.json

# === IDE / Editor ===
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-workspace
*.sublime-project

# === Build artifacts ===
dist/
build/
*.log
coverage/
.nyc_output/

# === Misc ===
.git/
*.tmp
*.bak

# === Original SambaPOS V3 source (kept locally for reference, NOT committed) ===
source/

# === Playwright test artifacts ===
backend/test-results/

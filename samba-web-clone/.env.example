# =====================================================================
# SambaPos_LBA — Example environment configuration
# =====================================================================
# Copy this file to `.env` and fill in real values before running.
#
#   cp .env.example .env
#   # edit .env — set at minimum: JWT_SECRET, CORS_ORIGIN, ADMIN_PIN
#   node backend/src/api/server.js
#
# Rules:
#   - NEVER commit the real .env file. .gitignore already excludes it.
#   - JWT_SECRET must be at least 32 characters. Generate one with:
#         openssl rand -hex 32
#   - In production (NODE_ENV=production), CORS_ORIGIN MUST NOT be '*'.
#     The server refuses to start otherwise (Phase 1 hardening).
#   - ADMIN_PIN is used only by the seed script to create the admin user.
#     It is hashed with bcrypt before being stored in the DB.
# =====================================================================

# --- Runtime ---
NODE_ENV=development
PORT=3001

# --- Authentication (REQUIRED) ---
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-32-char-min-secret-please
JWT_EXPIRES_IN=8h

# --- CORS (REQUIRED in production) ---
# Comma-separated list of allowed origins, e.g.:
#   https://pos.example.com,https://admin.example.com
# Set to '*' ONLY in development. The server refuses '*' in production.
CORS_ORIGIN=*

# --- Database ---
# SQLite path (relative to the backend package root or absolute).
# Defaults to <repo>/data/samba.db
SAMBA_DB_PATH=

# --- Seed bootstrap (only used by `npm run seed`) ---
# 4-8 digit PIN. Hashed with bcrypt before being stored.
ADMIN_PIN=1234

# --- Backups ---
# Directory for backup snapshots (used by `npm run backup`).
# Defaults to <repo>/data/backups
BACKUP_DIR=

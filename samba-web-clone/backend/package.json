{
  "name": "samba-web-clone-backend",
  "version": "0.3.0",
  "description": "Web clone of SambaPOS V3 — backend (Node.js + Knex + SQLite)",
  "main": "src/api/server.js",
  "scripts": {
    "start": "node src/api/server.js",
    "dev": "node --watch src/api/server.js",
    "migrate": "knex migrate:latest --knexfile src/infrastructure/db/knexfile.js",
    "migrate:rollback": "knex migrate:rollback --knexfile src/infrastructure/db/knexfile.js",
    "seed": "knex seed:run --knexfile src/infrastructure/db/knexfile.js",
    "test": "node --test tests/api-integration.test.js",
    "test:ticket": "node scripts/insert-ticket-demo.js",
    "test:sprint2": "node scripts/sprint2-acceptance-test.js",
    "test:e2e": "node scripts/sprint4-e2e-test.js",
    "test:playwright": "npx playwright test --reporter=line",
    "test:print": "node scripts/print-checksum-test.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "decimal.js": "^10.4.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sqlite3": "^5.1.7",
    "supertest": "^7.2.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}

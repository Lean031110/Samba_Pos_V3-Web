# =====================================================================
# .gitignore — SambaPos_LBA
# =====================================================================

# === Node.js ===
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.pnpm-debug.log*

# === Database files (NEVER commit) ===
data/samba.db
data/samba.db-wal
data/samba.db-shm
data/*.db
data/*.db-*
data/backups/
data/snapshots/
*.sdf
*.db
*.db-journal

# === Environment / secrets (NEVER commit) ===
.env
.env.*
!.env.example
.env.local
config/secrets.js
config/local.js
**/.env
**/credentials.json

# === IDE / Editor ===
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-workspace
*.sublime-project

# === Build artifacts ===
dist/
build/
*.log
coverage/
.nyc_output/

# === Tool / agent artifacts (never commit) ===
tool-results/
.tool-results/
agent-ctx/
download/

# === Misc ===
.git/
*.tmp
*.bak

# === Original SambaPOS V3 source (kept locally for reference, NOT committed) ===
source/

# === Playwright test artifacts ===
backend/test-results/
backend/tests/e2e/report/
backend/tests/e2e/results.xml
backend/tests/pages-smoke/.results/

# === Pages demo build (generated by scripts/build-pages-demo.js) ===
_site/

# === Android signing material (NEVER commit — GitHub Secrets only) ===
*.keystore
*.jks
android/release.keystore
android/gradle.properties.local

# === Local dev helpers ===
scripts/debug-pages.js.bak
